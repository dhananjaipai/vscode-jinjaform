# Complex nested Jinja within Terraform structures

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 4.0"
    }
  }
}

provider "aws" {
  region = "{{ region }}"
}

# Jinja conditional around entire resource
{% if enable_vpc %}
resource "aws_vpc" "main" {
  cidr_block           = "{{ vpc_cidr }}"
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name = "{{ environment }}-vpc"
    {% for tag_key, tag_value in extra_tags.items() %}
    "{{ tag_key }}" = "{{ tag_value }}"
    {% endfor %}
  }
}
{% endif %}

# Jinja loop generating multiple resources
{% for subnet in subnets %}
resource "aws_subnet" "subnet_{{ loop.index0 }}" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "{{ subnet.cidr }}"
  availability_zone       = "{{ subnet.az }}"
  map_public_ip_on_launch = {{ subnet.public | lower }}

  tags = {
    Name = "{{ environment }}-subnet-{{ subnet.name }}"
  }
}
{% endfor %}

# Security group with conditional rules
resource "aws_security_group" "app" {
  name        = "{{ app_name }}-sg"
  description = "Security group for {{ app_name }}"
  vpc_id      = aws_vpc.main.id

  {% if enable_http %}
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = [
      {% for cidr in allowed_cidrs %}
      "{{ cidr }}",
      {% endfor %}
    ]
  }
  {% endif %}

  {% if enable_https %}
  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = [
      {% for cidr in allowed_cidrs %}
      "{{ cidr }}",
      {% endfor %}
    ]
  }
  {% endif %}

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "{{ app_name }}-sg"
  }
}

# Jinja with deep nesting and conditional logic
{% for env in environments %}
  {% if env.enable_db %}
resource "aws_db_instance" "{{ env.name }}" {
  allocated_storage    = {{ env.db_storage }}
  storage_type         = "gp2"
  engine               = "{{ env.db_engine }}"
  engine_version       = "{{ env.db_version }}"
  instance_class       = "{{ env.db_instance_class }}"
  name                 = "{{ env.db_name }}"
  username             = "{{ env.db_username }}"
  password             = "{{ env.db_password }}"
  {% if env.enable_backup %}
  backup_retention_period = {{ env.backup_days }}
  backup_window           = "{{ env.backup_window }}"
  {% endif %}
  skip_final_snapshot  = {{ env.skip_snapshot | lower }}

  tags = {
    Name = "{{ env.name }}-db"
    Environment = "{{ env.name }}"
  }
}
  {% endif %}
{% endfor %}

# Variable with Jinja interpolation
locals {
  common_tags = {
    Project     = "{{ project_name }}"
    Environment = "{{ environment }}"
    ManagedBy   = "terraform"
    {% if include_owner %}
    Owner       = "{{ owner_email }}"
    {% endif %}
  }

  # Jinja-computed local value
  {% if multi_region %}
  region_map = {
    {% for region_name, region_config in regions.items() %}
    "{{ region_name }}" = "{{ region_config.zone }}"
    {% endfor %}
  }
  {% else %}
  region_map = {
    primary = "{{ primary_region }}"
  }
  {% endif %}
}

# Module with Jinja variables
{% if enable_monitoring %}
module "monitoring" {
  source = "{{ monitoring_module_path }}"

  environment = "{{ environment }}"
  app_name    = "{{ app_name }}"
  
  {% for metric in monitored_metrics %}
  enable_{{ metric }} = true
  {% endfor %}

  tags = merge(
    local.common_tags,
    {
      Module = "monitoring"
    }
  )
}
{% endif %}

# Output with Jinja in description
output "vpc_id" {
  value       = aws_vpc.main.id
  description = "VPC ID for {{ environment }} environment"
  
  {% if export_sensitive %}
  sensitive = true
  {% endif %}
}

{% for subnet in subnets %}
output "subnet_{{ loop.index0 }}_id" {
  value       = aws_subnet.subnet_{{ loop.index0 }}.id
  description = "Subnet ID for {{ subnet.name }}"
}
{% endfor %}
