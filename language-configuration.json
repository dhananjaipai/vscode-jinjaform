{
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{#", "#}"],
    ["{%", "%}"],
    ["{{", "}}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["@/", "/"],
    ["{#", "#}"],
    ["{%", "%}"],
    ["{{", "}}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "{%-{0,1}\\+{0,1}\\s*(block|filter|for|if|macro|raw|with|set)",
      "end": "{%-{0,1}\\+{0,1}\\s*end(block|filter|for|if|macro|raw|with|set)\\s*-{0,1}\\+{0,1}%}"
    }
  }
}